root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Godot's editor indents GDScript with tabs.
[*.gd]
indent_style = tab

[*.{tscn,tres,godot,cfg}]
indent_style = space
indent_size = 4

[*.{py,json,yml,yaml,csv,md}]
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf
