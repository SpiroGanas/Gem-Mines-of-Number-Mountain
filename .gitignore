# Godot 4.2+ specific ignores
~*.dll

# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# GdUnit4 test reports
reports/

# Export outputs
*.exe
# Uncomment if your project does not version PCK files as runtime dependencies.
# *.pck

# ---- Project-specific (see CLAUDE.md "Repository layout") ----
# Build outputs (APK/AAB, web export)
build/
*.aab
*.apk

# Godot's generated Android Gradle build template (installed per machine)
android/build/
android/.build_version

# Kotlin plugin build outputs (the built AAR is copied into addons/digit_ink/bin/ by tools/ci/copy_plugin.py)
android/plugins/digit_ink/build/
android/plugins/digit_ink/.gradle/
android/plugins/digit_ink/local.properties

# Charlie's exported logs and handwriting samples. Never commit or upload.
private/

# Signing keys and secrets (keys live in environment variables)
*.keystore
*.jks
*.pem
.env
.env.*

# Python tools
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Store listing work (Phase 3 plan, 3.10): keep the listing text, the render script, the SVG/KRA
# sources (keep each under 2 MB) and the exported release graphics in marketing/export/; ignore the
# rest (drafts, trailer captures, raw screenshots).
marketing/*
!marketing/.gdignore
!marketing/listing.md
!marketing/render.sh
!marketing/src/
marketing/src/*
!marketing/src/*.svg
!marketing/src/*.kra
!marketing/export/
