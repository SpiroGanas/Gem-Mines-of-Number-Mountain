; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Gem Mines of Number Mountain"
config/description="A mining-and-crafting adventure that teaches number theory, from counting and place value to modular arithmetic, ciphers and proof."
config/version="0.1.0"
run/main_scene="res://scenes/shell/shell.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Text="*res://autoload/text.gd"
UI="*res://autoload/ui.gd"
InputRouter="*res://autoload/input_router.gd"
SaveSystem="*res://autoload/save_system.gd"
Adaptive="*res://autoload/adaptive.gd"
Rewards="*res://autoload/rewards.gd"

[debug]

gdscript/warnings/untyped_declaration=2

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[gem_mines]

debug/capture_enabled=true
debug/force_slate=false
