## Writes the math reviewer's packet for Zones 1-5 (Sprint 21, P2-S21-02): for every skill its zone,
## prerequisites and Word Gems, then a few seeded problems exactly as the child sees them (Bolt's
## words from the text table, the answer, each wrong answer with the misconception it stands for and
## Bolt's targeted line). Developer tool, not exported. Run headless:
##   "$GODOT" --headless --path . res://tools/qa/math_review_packet.tscn
## Output: docs/reviews/math-review-packet-z1-5.md (regenerate whenever a generator or a line changes).
##
## Phase 4 zones get their own packet with 30 samples per skill (plan, three-sprint zone pattern, step
## A7), chosen by user arguments after `--`:
##   "$GODOT" --headless --path . res://tools/qa/math_review_packet.tscn -- --zones 6 --samples 30
## writes docs/reviews/math-review-packet-z6.md. A fraction or ratio answer is shown as the child's
## button reads it ("3/4", "2 : 3").
extends Node

const OUT_PATH: String = "res://docs/reviews/math-review-packet-z1-5.md"
const SAMPLES_PER_SKILL: int = 3
const LAST_ZONE: int = 5

var first_zone: int = 1
var last_zone: int = LAST_ZONE
var samples_per_skill: int = SAMPLES_PER_SKILL


## Reads `--zones 6` or `--zones 6-7` and `--samples 30` from the user arguments (after `--`).
func _read_arguments() -> void:
	var args: PackedStringArray = OS.get_cmdline_user_args()
	for index: int in args.size() - 1:
		match args[index]:
			"--zones":
				var span: PackedStringArray = args[index + 1].split("-")
				first_zone = int(span[0])
				last_zone = int(span[span.size() - 1])
			"--samples":
				samples_per_skill = maxi(int(args[index + 1]), 1)


## The packet's file: the Phase 2 packet for Zones 1-5, else one per zone or zone span.
func out_path() -> String:
	if first_zone == 1 and last_zone == LAST_ZONE:
		return OUT_PATH
	var span: String = str(first_zone) if first_zone == last_zone else "%d-%d" % [first_zone, last_zone]
	return "res://docs/reviews/math-review-packet-z%s.md" % span


func _ready() -> void:
	_read_arguments()
	var catalog: SkillCatalog = Adaptive.catalog()
	var lines: PackedStringArray = PackedStringArray()
	lines.append("# Math review packet: Zone %d" % first_zone if first_zone == last_zone else "# Math review packet: Zones %d to %d" % [first_zone, last_zone])
	lines.append("")
	lines.append("Generated by `tools/qa/math_review_packet.tscn` on %s from the curriculum, the generators and `text/lines.csv`. Every answer below was also recomputed by the independent Python checkers (`tools/crosscheck/`, 10,000 problems per skill). For each skill: does the wording say what the child must do, is the answer right, are the wrong answers mistakes a child really makes, and is the order of skills (prerequisites) sound? Write findings in `docs/reviews/2027-04-math-review.md`." % Time.get_date_string_from_system())
	var zone: int = 0
	var count: int = 0
	for id: StringName in catalog.ids():
		var skill: Skill = catalog.skill(id)
		if skill.zone < first_zone or skill.zone > last_zone or not GeneratorRegistry.callable_for(skill).is_valid():
			continue
		if skill.zone != zone:
			zone = skill.zone
			lines.append("")
			lines.append("## Zone %d: %s" % [zone, Text.get_line(ZoneBanner.line_for(zone))])
		count += 1
		lines.append("")
		lines.append("### `%s`: %s" % [skill.id, skill.name])
		lines.append("")
		lines.append("- Prerequisites: %s" % (", ".join(skill.prereqs.map(func(p: StringName) -> String: return "`%s`" % p)) if not skill.prereqs.is_empty() else "none"))
		lines.append("- Word Gems: %s; answer modes: %s; representations: %s" % [", ".join(skill.terms.map(func(t: StringName) -> String: return String(t))) if not skill.terms.is_empty() else "none", ", ".join(skill.answer_modes.map(func(m: StringName) -> String: return String(m))), ", ".join(skill.representations.map(func(r: StringName) -> String: return String(r)))])
		for sample: int in samples_per_skill:
			var representation: StringName = skill.representations[sample % skill.representations.size()]
			var problem: Problem = GeneratorRegistry.make_problem(skill, 1000 + sample, {"representation": representation})
			lines.append("- Seed %d (%s): \"%s\" Answer: **%s**." % [problem.seed, representation, Text.get_line(problem.prompt_line_id, problem.prompt_params), _show(problem.answer)])
			for entry: Dictionary in problem.distractors:
				var targeted: StringName = StringName("bolt.misconception.%s" % entry["misconception"])
				var bolt_line: String = Text.get_line(targeted) if Text.has_line(targeted) else "(no targeted line)"
				lines.append("  - Wrong answer %s (`%s`): Bolt says \"%s\"" % [_show(entry["value"]), entry["misconception"], bolt_line])
	lines.append("")
	lines.append("%d skills." % count)
	var file: FileAccess = FileAccess.open(ProjectSettings.globalize_path(out_path()), FileAccess.WRITE)
	file.store_string("\n".join(lines) + "\n")
	file.close()
	print("math review packet: %d skills written to %s" % [count, out_path()])
	get_tree().quit()


static func _show(value: Variant) -> String:
	if value is Array:
		var parts: PackedStringArray = PackedStringArray()
		for item: Variant in value:
			parts.append(_show(item))
		return "[" + ", ".join(parts) + "]"
	if value is Dictionary and value.size() == 2 and ((value.has("num") and value.has("den")) or (value.has("a") and value.has("b"))):
		return AnswerPanel.label_for(value, Problem.new()) # a fraction "3/4" or a ratio "2 : 3"
	if value is Dictionary:
		return JSON.stringify(value)
	if value is float and is_equal_approx(value, roundf(value)):
		return str(int(value))
	return str(value)
