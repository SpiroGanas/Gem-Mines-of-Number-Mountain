## Writes the math reviewer's packet for Zones 1-5 (Sprint 21, P2-S21-02): for every skill its zone,
## prerequisites and Word Gems, then a few seeded problems exactly as the child sees them (Bolt's
## words from the text table, the answer, each wrong answer with the misconception it stands for and
## Bolt's targeted line). Developer tool, not exported. Run headless:
##   "$GODOT" --headless --path . res://tools/qa/math_review_packet.tscn
## Output: docs/reviews/math-review-packet-z1-5.md (regenerate whenever a generator or a line changes).
## Phase 4: one zone's packet with `-- --zones 7` (or a range, `--zones 6-7`), written to
## docs/reviews/math-review-packet-z7.md with SAMPLES_PER_NEW_SKILL problems per skill.
extends Node

const OUT_PATH: String = "res://docs/reviews/math-review-packet-z1-5.md"
const ZONE_OUT_PATH: String = "res://docs/reviews/math-review-packet-z%s.md"
const SAMPLES_PER_SKILL: int = 3
## A new zone's packet shows more problems per skill (the plan asks for 30 samples per skill; the
## packet shows the first SAMPLES_PER_NEW_SKILL and the cross-check covers 10,000).
const SAMPLES_PER_NEW_SKILL: int = 6
const LAST_ZONE: int = 5

var _first_zone: int = 1
var _last_zone: int = LAST_ZONE
var _out_path: String = OUT_PATH
var _samples: int = SAMPLES_PER_SKILL


## Reads `--zones 7` or `--zones 6-7` from the command line after `--`.
func _read_arguments() -> void:
	var args: PackedStringArray = OS.get_cmdline_user_args()
	var at: int = args.find("--zones")
	if at < 0 or at + 1 >= args.size():
		return
	var parts: PackedStringArray = args[at + 1].split("-")
	_first_zone = int(parts[0])
	_last_zone = int(parts[parts.size() - 1])
	_out_path = ZONE_OUT_PATH % args[at + 1]
	_samples = SAMPLES_PER_NEW_SKILL


func _ready() -> void:
	_read_arguments()
	var catalog: SkillCatalog = Adaptive.catalog()
	var lines: PackedStringArray = PackedStringArray()
	if _first_zone == 1 and _last_zone == LAST_ZONE:
		lines.append("# Math review packet: Zones 1 to %d" % LAST_ZONE)
	else:
		lines.append("# Math review packet: Zone %s" % (str(_first_zone) if _first_zone == _last_zone else "%d to %d" % [_first_zone, _last_zone]))
	lines.append("")
	lines.append("Generated by `tools/qa/math_review_packet.tscn` on %s from the curriculum, the generators and `text/lines.csv`. Every answer below was also recomputed by the independent Python checkers (`tools/crosscheck/`, 10,000 problems per skill). For each skill: does the wording say what the child must do, is the answer right, are the wrong answers mistakes a child really makes, and is the order of skills (prerequisites) sound? Write findings in %s." % [Time.get_date_string_from_system(), "`docs/reviews/2027-04-math-review.md`" if _out_path == OUT_PATH else "the zone's \"Needs reviewer\" entry in `docs/decisions.md`"])
	var zone: int = 0
	var count: int = 0
	for id: StringName in catalog.ids():
		var skill: Skill = catalog.skill(id)
		if skill.zone < _first_zone or skill.zone > _last_zone or not GeneratorRegistry.callable_for(skill).is_valid():
			continue
		if skill.zone != zone:
			zone = skill.zone
			lines.append("")
			lines.append("## Zone %d: %s" % [zone, Text.get_line(ZoneBanner.line_for(zone))])
		count += 1
		lines.append("")
		lines.append("### `%s`: %s" % [skill.id, skill.name])
		lines.append("")
		lines.append("- Prerequisites: %s" % (", ".join(skill.prereqs.map(func(p: StringName) -> String: return "`%s`" % p)) if not skill.prereqs.is_empty() else "none"))
		lines.append("- Word Gems: %s; answer modes: %s; representations: %s" % [", ".join(skill.terms.map(func(t: StringName) -> String: return String(t))) if not skill.terms.is_empty() else "none", ", ".join(skill.answer_modes.map(func(m: StringName) -> String: return String(m))), ", ".join(skill.representations.map(func(r: StringName) -> String: return String(r)))])
		for sample: int in _samples:
			var representation: StringName = skill.representations[sample % skill.representations.size()]
			var problem: Problem = GeneratorRegistry.make_problem(skill, 1000 + sample, {"representation": representation})
			lines.append("- Seed %d (%s): \"%s\" Answer: **%s**." % [problem.seed, representation, Text.get_line(problem.prompt_line_id, problem.prompt_params), _show(problem.answer)])
			for entry: Dictionary in problem.distractors:
				var targeted: StringName = StringName("bolt.misconception.%s" % entry["misconception"])
				var bolt_line: String = Text.get_line(targeted) if Text.has_line(targeted) else "(no targeted line)"
				lines.append("  - Wrong answer %s (`%s`): Bolt says \"%s\"" % [_show(entry["value"]), entry["misconception"], bolt_line])
	lines.append("")
	lines.append("%d skills." % count)
	var file: FileAccess = FileAccess.open(ProjectSettings.globalize_path(_out_path), FileAccess.WRITE)
	file.store_string("\n".join(lines) + "\n")
	file.close()
	print("math review packet: %d skills written to %s" % [count, _out_path])
	get_tree().quit()


static func _show(value: Variant) -> String:
	if value is Array:
		var parts: PackedStringArray = PackedStringArray()
		for item: Variant in value:
			parts.append(_show(item))
		return "[" + ", ".join(parts) + "]"
	if value is Dictionary:
		if Rational.is_fraction(value) or Rational.is_mixed(value) or Rational.is_decimal(value) or Rational.is_ratio(value):
			return Text.display_value(value) # 3/4, 2 1/3, 0.25, 2 : 3 (Zone 7)
		return JSON.stringify(value)
	if value is int and value < 0:
		return Text.display_value(value)
	if value is float and is_equal_approx(value, roundf(value)):
		return str(int(value))
	return str(value)
